# Stand-ins for the postBuild substitution variables Terraform publishes, so
# validate.sh can render what kustomize-controller renders. One line per key
# of every object a clusters/*/ Kustomization lists in substituteFrom. The
# values only have to be shaped right, not be real.

# cluster-versions (ConfigMap, flux-system)
talos_version=v1.12.0
kubernetes_version=v1.35.0

# karpenter-vars (Secret, flux-system). node_user_data and capacity_types are
# JSON-encoded by Terraform, as here; the outer single quotes are shell
# quoting and are not part of the value.
cluster_name=example
discovery_tag=example
node_instance_profile=example-worker
node_ami_id=ami-0123456789abcdef0
node_architecture=amd64
node_user_data='"version: v1alpha1\nmachine:\n  type: worker\n"'
capacity_types='["spot","on-demand"]'
